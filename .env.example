# ---------------------------------------------------------------------------
# Supabase
# Project Settings > Data API  /  Project Settings > API Keys
# Both values below are safe to expose to the browser (they are protected by
# Row Level Security). NEVER put the service_role key in this file.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL used for the magic-link redirect.
# Local:      http://localhost:3000
# Production: https://<your-project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudflare Workers AI（Learning Pages の構造化に使用）
# server 専用。NEXT_PUBLIC_ を付けてはいけない（ブラウザへ漏れる）。
# Cloudflare Dashboard > Workers & Pages > Overview に Account ID がある。
# API Token は「Workers AI」の Read 権限で作成する。
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
